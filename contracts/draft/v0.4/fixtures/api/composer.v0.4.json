        {
          "code": "not_found",
          "status": 404,
          "when": "home not visible to the caller"
        },
        {
          "code": "dependency_unavailable",
          "status": 503,
          "when": "Home Scanner or Resvanta unavailable"
        }
      ],
      "expected_version": "none",
