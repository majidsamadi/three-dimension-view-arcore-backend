{
  "api_root": "https://composer.dev.wizestay.com/api/v1",
  "bff_service": "composer",
  "contract": "wisestay.composer.api",
  "example_notes": "Synthetic IDs and users only (USER-A = token-A, USER-B = token-B). request_example is {path_params, query, headers, body}; response_example is the JSON body. envelope_sha256 values of 64 zeros are placeholders for the digest of the service-written envelope bytes. 400 idempotency_key_required, 401 identity_required and 409 idempotency_key_reuse apply to every route as listed in conventions.v0.4.json.",
  "fit_rules": {
    "approximate": "claims estimated or seller-declared",
    "combined_uncertainty_m": "sqrt(u_obj^2 + u_room^2); u_obj = max(0.01, 0.03*max(dimensions_m)); u_room = max(0.05, 0.02*max(home bounds extent))",
    "margin_m": "clearance_margin_m; footprint: minimum distance from the footprint to the home bounds",
    "openings": "reasons [opening_clearance_not_supported]",
    "otherwise": "unverified_fit",
    "thresholds_version": "Q03-provisional-2026-10-20",
    "unknown": "illustrative mode, or either scale claim unknown",
    "verified_fit": "both claims in {reference-supported, independently-verified} and combined_uncertainty_m < margin_m"
  },
  "producer": "home-composer-backend",
  "roles": {
    "commenter": {
      "comment": true,
      "edit": false,
      "read": true,
      "share_archive": false
    },
    "editor": {
      "comment": true,
      "edit": true,
      "read": true,
      "share_archive": false
    },
    "owner": {
      "comment": true,
      "edit": true,
      "read": true,
      "share_archive": true
    },
    "viewer": {
      "comment": false,
      "edit": false,
      "read": true,
      "share_archive": false
    }
  },
  "routes": [
    {
      "errors": [
        {
          "code": "validation_failed",
          "status": 422,
          "when": "home_source null outside non_property_sandbox, or unknown context_kind"
