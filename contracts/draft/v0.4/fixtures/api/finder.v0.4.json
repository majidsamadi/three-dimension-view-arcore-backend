{
  "api_root": "https://finder.dev.wizestay.com/api/v1",
  "bff_service": "finder",
  "contract": "wisestay.finder.api",
  "example_notes": "Synthetic IDs and users only (USER-A = token-A, USER-B = token-B). request_example is {path_params, query, headers, body}; response_example is the JSON body. envelope_sha256 values of 64 zeros are placeholders for the digest of the service-written envelope bytes. 400 idempotency_key_required, 401 identity_required and 409 idempotency_key_reuse apply to every route as listed in conventions.v0.4.json.",
  "matcher": {
    "class": "DeterministicIdentifierTextMatcher",
    "id": "deterministic-identifier-text",
    "port": "MatcherPort.match(query, catalog_snapshot) -> MatchOutcome",
    "rules": [
      {
        "classification": "exact-confirmed",
        "rule": "identifier equals a variant GTIN or merchant SKU"
      },
      {
        "classification": "exact-confirmed",
        "rule": "object_id linked to exactly one variant"
      },
      {
        "candidates": "one per variant",
        "classification": "ambiguous",
        "rule": "object_id linked to more than one variant"
      },
      {
        "classification": "probable",
        "rule": "text: normalised brand + model equal"
      },
      {
        "classification": "similar",
        "rule": "text: >= 50 % of query tokens in the family name"
      },
      {
        "processing_status": "completed",
        "result_classification": "no-match",
        "rule": "no candidates"
      }
    ],
    "version": "1"
  },
  "membership_roles": [
    "merchant_manager",
    "staff_capture",
    "reviewer"
  ],
  "producer": "where-can-find-this-backend",
  "result_alt1": {
    "candidate_classifications": [
      "exact-confirmed",
      "probable",
      "similar",
      "ambiguous"
    ],
    "facets": [
      "processing_status",
      "result_classification",
      "candidates[].classification",
      "candidates[].reason"
    ],
    "precedence": false,
    "processing_states": [
      "completed",
      "provider_failed",
      "unsupported_input",
      "partial"
    ],
    "provider_failed": "result_classification absent, never no-match",
    "reason_codes": [
      "gtin_exact",
      "merchant_sku_exact",
      "object_link_exact",
      "object_link_multiple_variants",
      "brand_model_exact",
      "token_overlap"
    ],
    "result_classifications": [
      "exact-confirmed",
      "probable",
      "similar",
      "ambiguous",
      "no-match"
    ],
    "scores": false,
    "unknown_is_classification": false
  },
